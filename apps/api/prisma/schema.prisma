// Phase 1 data model.
// Lat/lng are stored as plain floats for now — PostGIS geometry columns
// and spatial queries (proximity, catchment areas) come in Phase 3
// once the core data flow is proven. Swapping to a `geography(Point,4326)`
// column later is a straightforward migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionType {
  PRIMARY
  SECONDARY
  UNIVERSITY
}

enum OwnershipType {
  GOVERNMENT
  PRIVATE
}

enum FacilityCategory {
  CLASSROOM
  TOILET
  WATER
  ELECTRICITY
  LIBRARY
  LABORATORY
  OTHER
}

enum FacilityCondition {
  GOOD
  FAIR
  POOR
  NOT_FUNCTIONAL
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  INSPECTOR
  SCHOOL_ADMIN
}

enum InterventionType {
  MATERIAL_DISTRIBUTION
  INFRASTRUCTURE_REPAIR
  SECURITY_DEPLOYMENT
  RESCUE_OPERATION
  OTHER
}

enum InterventionStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InterventionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityIncidentType {
  INTRUSION
  KIDNAPPING_THREAT
  ARMED_ATTACK
  NATURAL_DISASTER
  FIRE
  STRUCTURAL_HAZARD
  OTHER
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  VERIFIED
  RESPONSE_DISPATCHED
  RESOLVED
  FALSE_ALARM
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  type      OwnershipType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  institutions      Institution[]
  adminRegions      AdminRegion[]
  interventions     Intervention[]
  securityIncidents SecurityIncident[]
}

// Self-referencing hierarchy so each tenant can define its own depth:
// e.g. a federal ministry might use State -> LGA -> School, while a
// private school network might just use Zone -> School.
model AdminRegion {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  level    Int // 0 = top of this tenant's hierarchy, increases with depth
  parentId String?
  parent   AdminRegion?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children AdminRegion[] @relation("RegionHierarchy")

  institutions Institution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([parentId])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(INSPECTOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspections           Inspection[]
  interventionsCreated  Intervention[]
  incidentsReported     SecurityIncident[]
}

model Institution {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  name       String
  type       InstitutionType
  ownership  OwnershipType
  lat        Float
  lng        Float
  address    String?
  regionId   String?
  region     AdminRegion?     @relation(fields: [regionId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  facilities        Facility[]
  enrollmentRecords EnrollmentRecord[]
  inspections       Inspection[]
  interventions     Intervention[]
  securityIncidents SecurityIncident[]

  @@index([tenantId])
  @@index([regionId])
}

model Facility {
  id              String            @id @default(uuid())
  institutionId   String
  institution     Institution       @relation(fields: [institutionId], references: [id])
  category        FacilityCategory
  condition       FacilityCondition
  notes           String?
  lastInspectedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([institutionId])
}

model EnrollmentRecord {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  term          String // e.g. "2026-T1"
  studentCount  Int
  staffCount    Int
  maleCount     Int?
  femaleCount   Int?
  createdAt     DateTime    @default(now())

  @@index([institutionId])
}

model Inspection {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  inspectorId   String
  inspector     User        @relation(fields: [inspectorId], references: [id])
  responses     Json // dynamic checklist responses, tenant-defined
  status        String      @default("SUBMITTED")
  submittedAt   DateTime    @default(now())
  syncedAt      DateTime?

  @@index([institutionId])
}

// Tracks the response side: material distribution, repairs, security
// deployments, rescue operations - planned through to completion.
model Intervention {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  institutionId String
  institution   Institution          @relation(fields: [institutionId], references: [id])
  type          InterventionType
  description   String?
  status        InterventionStatus   @default(PLANNED)
  priority      InterventionPriority @default(MEDIUM)
  budget        Float?
  resources     Json? // e.g. [{ "item": "Desks", "quantity": 50 }]
  plannedDate   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId])
  @@index([institutionId])
  @@index([status])
  @@index([priority])
}

// Distinct from routine facility inspection - drives rescue/security response.
model SecurityIncident {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  institutionId String
  institution   Institution          @relation(fields: [institutionId], references: [id])
  type          SecurityIncidentType
  severity      SecuritySeverity
  description   String?
  occurredAt    DateTime
  reportedById  String
  reportedBy    User                 @relation(fields: [reportedById], references: [id])
  status        IncidentStatus       @default(REPORTED)
  responseNotes String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId])
  @@index([institutionId])
  @@index([severity])
  @@index([status])
}
