# Railway injects DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/school_monitor?schema=public"

# Generate a strong random value for production, e.g.: openssl rand -base64 32
JWT_SECRET="dev-secret-change-me"

# Comma-separated list of allowed web origins, e.g. https://app.yourdomain.com
CORS_ORIGIN="*"

PORT=3000
